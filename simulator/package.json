    "start": "node server/index.js"
  },
  "dependencies": {
    "compression": "1.7.5",
    "express": "4.21.1"
  },
  "devDependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@vitejs/plugin-react": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "vite": "5.4.10",
    "zustand": "4.5.5"
  }
}
