{
  "name": "stockout-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D interactive simulator for stockout-aware demand forecasting and newsvendor ordering",
  "scripts": {
    "export": "python export/export_assets.py",
    "verify": "node server/verify.js",
