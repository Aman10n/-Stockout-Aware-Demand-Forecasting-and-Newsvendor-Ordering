	partition fact_order = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_order.csv"), [Delimiter = ",", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date_key", "series_key", "policy_key", "scenario_key", "order_qty", "demand", "sold_units", "shortage_units", "leftover_units", "cost"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date_key", Int64.Type}, {"series_key", Int64.Type}, {"policy_key", Int64.Type}, {"scenario_key", Int64.Type}, {"order_qty", type number}, {"demand", type number}, {"sold_units", type number}, {"shortage_units", type number}, {"leftover_units", type number}, {"cost", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
