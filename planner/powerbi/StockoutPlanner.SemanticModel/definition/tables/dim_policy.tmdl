	partition dim_policy = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_policy.csv"), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"policy_key", "stockout_aware"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"policy_key", Int64.Type}, {"policy_code", type text}, {"policy_name", type text}, {"stockout_aware", type logical}, {"description", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
