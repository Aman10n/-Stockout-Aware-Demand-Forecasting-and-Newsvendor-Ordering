table security_user_city
	lineageTag: b53df5d1-7ce0-5075-a1f9-7e0cfb54fcfc
	isHidden

	column user_email
		dataType: string
		isHidden
		lineageTag: 5787dc18-579f-5fa1-9d99-735153a57de6
		summarizeBy: none
		sourceColumn: user_email

	column city
		dataType: string
