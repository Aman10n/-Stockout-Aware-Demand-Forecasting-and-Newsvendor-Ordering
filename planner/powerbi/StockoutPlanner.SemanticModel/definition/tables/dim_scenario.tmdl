	partition dim_scenario = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_scenario.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"scenario_key", "c_u", "c_o", "beta"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario_key", Int64.Type}, {"scenario_name", type text}, {"c_u", Int64.Type}, {"c_o", Int64.Type}, {"beta", type number}, {"quantile", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
