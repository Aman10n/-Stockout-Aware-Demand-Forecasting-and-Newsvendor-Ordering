table dim_scenario
	lineageTag: daae8b52-9304-53ef-ae44-23935aae044f

	column scenario_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cef43755-d606-5511-9ecc-1632fbab9495
		summarizeBy: none
		sourceColumn: scenario_key

	column scenario_name
		dataType: string
		lineageTag: 939830f3-2e93-54d0-ad45-b2f64da60372
		summarizeBy: none
		sourceColumn: scenario_name
		sortByColumn: scenario_key

	column c_u
		dataType: int64
		formatString: 0
		lineageTag: f9bede8c-6d3d-5d7a-bb0c-211e9b364ce0
		summarizeBy: none
		sourceColumn: c_u

	column c_o
		dataType: int64
		formatString: 0
		lineageTag: 06eea414-c176-5ce3-ba70-7d5555e2d1d4
		summarizeBy: none
		sourceColumn: c_o

	column beta
		dataType: double
		formatString: 0.00
		lineageTag: 1f4655c8-49ee-5ce1-a7a9-c8ab6ae5b9eb
		summarizeBy: none
		sourceColumn: beta

	column quantile
		dataType: string
		lineageTag: 0b3b78a0-08ed-59be-86ca-30ff9457fb42
		summarizeBy: none
