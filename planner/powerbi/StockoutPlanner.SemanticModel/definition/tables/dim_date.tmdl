	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Columns = 11, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"date_key", "date", "day_index", "weekday_num", "week_start", "iso_week", "is_weekend", "period_order"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date_key", Int64.Type}, {"date", type date}, {"day_index", Int64.Type}, {"weekday_num", Int64.Type}, {"weekday_name", type text}, {"week_start", type date}, {"iso_week", Int64.Type}, {"month_name", type text}, {"is_weekend", type logical}, {"period", type text}, {"period_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
