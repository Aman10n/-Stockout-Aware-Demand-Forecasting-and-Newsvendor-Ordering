	partition dim_model = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_model.csv"), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"model_key", "stockout_aware"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"model_key", Int64.Type}, {"model_code", type text}, {"model_name", type text}, {"stockout_aware", type logical}, {"description", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
