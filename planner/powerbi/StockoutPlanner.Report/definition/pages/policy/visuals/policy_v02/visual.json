{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "policy_v02",
  "position": {
    "x": 20,
    "y": 96,
    "z": 2000,
    "width": 520,
    "height": 300,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_policy"
                    }
                  },
                  "Property": "policy_name"
                }
              },
              "queryRef": "dim_policy.policy_name",
              "nativeQueryRef": "policy_name"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Fill Rate %"
                }
              },
              "queryRef": "_Measures.Fill Rate %",
              "nativeQueryRef": "Fill Rate %"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Mean Cost"
                }
              },
              "queryRef": "_Measures.Mean Cost",
              "nativeQueryRef": "Mean Cost"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "categoryLabels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Demo policies: cost vs fill rate (lower-right is better)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}